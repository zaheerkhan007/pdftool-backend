# Copy to .env for local dev
SECRET_KEY=dev-insecure-change-me
DEBUG=True
# localhost entries keep local dev working; add your production hostnames too.
ALLOWED_HOSTS=localhost,127.0.0.1,api.quickietool.com,quickietool.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://quickietool.com,https://www.quickietool.com
MAX_UPLOAD_MB=50

# Postgres. Set False to fall back to a zero-config SQLite file instead.
# Local setup: createuser + createdb, or see the psql snippet in the README.
USE_POSTGRES=True
POSTGRES_DB=pdftools
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Redis (only needed once you enable async jobs)
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Production only ------------------------------------------------------
# Set when a TLS-terminating reverse proxy (Caddy) sits in front of gunicorn.
# Makes Django trust X-Forwarded-Proto and mark cookies Secure. Leave False in
# dev — trusting that header with no proxy in front lets a client spoof it.
BEHIND_TLS_PROXY=False
# Origins allowed to POST to the Django admin / any session-auth endpoint.
# Must include the scheme.
#
# NOTE: the browser never calls Django directly — Next proxies /api/* to the
# internal Docker hostname — so this is only for session-authenticated POSTs
# such as the Django admin, and should list the backend's own public hostname.
CSRF_TRUSTED_ORIGINS=https://api.quickietool.com

# Optional bootstrap superuser, created once on container start if both are set.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
