# Copy to .env for local dev
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=50

# Set True and fill these for Postgres (recommended for production)
USE_POSTGRES=False
POSTGRES_DB=pdftools
POSTGRES_USER=pdftools
POSTGRES_PASSWORD=pdftools
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery / Redis (only needed once you enable async jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
